HOST=127.0.0.1
PORT=3188
DEMO_MODE=false
AUTH_MODE=sms
FACTORY_NAME=工厂生产记工
DB_PATH=./data/production.sqlite
# 仅支持短信验证码登录；启动前填写腾讯云短信配置。
APP_SECRET=
ADMIN_PHONE=
OFFICIAL_ROSTER=true
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-beijing
# 验证码单变量模板用code；验证码、分钟两个变量用code,minutes。
TENCENT_SMS_TEMPLATE_PARAMS=code
# 选择SMS_PROVIDER=webhook时才填写以下两个字段。
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# 直接访问为0；前置一层可信反向代理时为1。
TRUST_PROXY=0

# 本地私有目录不上传Git，也不打进Docker镜像。
PRIVATE_DATA_DIR=./private-data
