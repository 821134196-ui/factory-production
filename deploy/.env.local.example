# 本地电脑作为服务器，手机和电脑连接同一局域网。
HOST=0.0.0.0
PORT=3188
DEMO_MODE=false
AUTH_MODE=sms
FACTORY_NAME=工厂生产记工
DB_PATH=./data/production-live.sqlite
APP_SECRET=
ADMIN_PHONE=
OFFICIAL_ROSTER=true
TRUST_PROXY=0
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-beijing
# 推荐模板：您的验证码为{1}，5分钟内有效。请勿向他人泄露验证码。
# 模板只有验证码变量用code；如第二个变量是有效分钟用code,minutes。
TENCENT_SMS_TEMPLATE_PARAMS=code

# 本地私有目录不上传Git，也不打进Docker镜像。
PRIVATE_DATA_DIR=./private-data
