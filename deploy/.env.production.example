SITE_DOMAIN=production.example.com
ACME_EMAIL=admin@example.com
APP_ENV_FILE=.env
FACTORY_NAME=工厂生产记工
# 留空自动生成并保存；迁移旧库时可填写原APP_SECRET。
APP_SECRET=
ADMIN_PHONE=
OFFICIAL_ROSTER=true
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-beijing
TENCENT_SMS_TEMPLATE_PARAMS=code
# 使用其他短信网关时改为SMS_PROVIDER=webhook并填写以下字段。
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
DEMO_MODE=false
AUTH_MODE=sms
HOST=0.0.0.0
PORT=3188
TRUST_PROXY=1
DB_PATH=/app/data/production.sqlite

# 本地私有目录不上传Git，也不打进Docker镜像。
PRIVATE_DATA_DIR=./private-data
