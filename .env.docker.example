# 启动前复制为.env.docker，并填写腾讯云短信凭证、应用、签名和模板信息。
FACTORY_NAME=工厂生产记工
AUTH_MODE=sms
DEMO_MODE=false
OFFICIAL_ROSTER=true
# 业务资料从本地private-data目录读取；默认不自动导入历史表格。
IMPORT_BUNDLED_DATA=false
ADMIN_PHONE=
# 留空时自动生成密钥并保存在数据库卷中，重建容器后继续使用。
# 迁移现有数据库时，继续使用原环境的APP_SECRET；首次升级短信登录仍需重新验证手机。
APP_SECRET=
TRUST_PROXY=0
SMS_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-beijing
TENCENT_SMS_TEMPLATE_PARAMS=code

# 本地私有目录不上传Git，也不打进Docker镜像。
PRIVATE_DATA_DIR=./private-data
