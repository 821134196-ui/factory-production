<view class="page-shell" style="font-size:{{fontSize}}px"><page-head title="历史数据核准" subtitle="{{subtitle}}" demo="{{demoMode}}"/>
<view class="card"><view class="field"><view class="field-label">表格月份</view><picker mode="date" fields="month" value="{{month}}" end="{{todayMonth}}" bindchange="month"><view class="picker">{{month}} ▾</view></picker></view><view class="field"><view class="field-label">表格类型</view><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex]}} ▾</view></picker></view><view class="small">选择原格式xlsx，先预览并核准，再计入统计。表格只有班组总量时，不推算个人数量。</view><button class="primary space" bindtap="upload" disabled="{{busy}}">选择表格并预览</button></view>
<block wx:if="{{preview}}"><view class="card"><view class="title">{{preview.fileName}}</view><view class="small">{{preview.month}} · {{preview.total}}条；可导入{{preview.readyCount}}条，待处理{{preview.blockedCount}}条，已导入{{preview.importedCount}}条。</view><view class="small space">单位、人员、日期存在问题的记录暂不导入。</view><button class="soft" bindtap="refresh" disabled="{{busy}}">刷新预览</button><view wx:if="{{access.review}}" class="row space"><button bindtap="all">全选可导入</button><button bindtap="clear">清空选择</button></view></view><checkbox-group bindchange="select"><view wx:for="{{entries}}" wx:key="sourceRef" class="card"><label class="check-line"><checkbox wx:if="{{access.review}}" value="{{item.sourceRef}}" checked="{{item.checked}}" disabled="{{item.disabled}}"/><text>{{item.date}} · {{item.workerName||'历史班组总量'}}</text></label><view>{{item.productFullName||item.productName}} · {{item.quantity}} {{item.unit||'单位待确认'}}</view><view class="small">{{item.sheet}} / {{item.cell}}</view><view wx:if="{{item.issue}}" class="correction">{{item.issue}}</view><view wx:if="{{item.recordId}}" class="small">已导入，不会重复入账。</view></view></checkbox-group><view class="row"><button data-delta="-30" bindtap="page" disabled="{{offset===0}}">上一页</button><button data-delta="30" bindtap="page" disabled="{{end>=preview.total}}">下一页</button></view><view class="small space">显示{{offset+1}}–{{end}} / {{preview.total}}；已选{{selectedCount}}条</view><button wx:if="{{access.review}}" class="primary space" bindtap="commit" disabled="{{busy}}">核准并导入所选</button></block>
<view class="title">历史导入预览</view><view wx:for="{{imports}}" wx:key="id" class="card"><view>{{item.fileName}}</view><view class="small">{{item.month}} · {{item.total}}条 · 已导入{{item.importedCount}}条</view><button class="soft" data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">{{access.review?'查看 / 核准':'查看预览'}}</button></view><button class="secondary" bindtap="back">返回管理</button></view>
