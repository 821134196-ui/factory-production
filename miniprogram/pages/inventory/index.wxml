<view class="page-shell" style="font-size:{{fontSize}}px"><page-head title="发货与库存" subtitle="{{subtitle}}" demo="{{demoMode}}"/>
<block wx:if="{{!editing&&!setting&&!flow}}"><view class="tabs"><button class="{{tab==='shipments'?'active':''}}" data-value="shipments" bindtap="tab">发货清单</button><button class="{{tab==='stock'?'active':''}}" data-value="stock" bindtap="tab">库存统计</button></view><view class="field"><view class="field-label">查询日期</view><nice-select options="{{dates}}" value="{{queryDate}}" font-size="{{fontSize}}" bindchange="queryDate"/></view><button class="text-action" bindtap="month">本月汇总</button><view class="small space">{{from}} 至 {{to}}</view>
<block wx:if="{{tab==='shipments'}}"><button wx:if="{{access.shipping||user.isLeader}}" class="primary" bindtap="shipment">填写发货清单</button><view wx:for="{{shipments}}" wx:key="id" class="card"><view class="record-head"><text>{{item.customer}}</text><text class="small">{{item.date}}</text></view><view wx:for="{{item.entries}}" wx:for-item="entry" wx:key="index" class="summary"><text>{{entry.product.fullName}}</text><text class="strong">{{entry.quantityText}} {{entry.product.unit}}</text></view><view wx:if="{{item.vehicleNumber}}" class="small">车号：{{item.vehicleNumber}}</view><button wx:if="{{item.pumpFile}}" class="text-action" data-id="{{item.pumpFile.id}}" data-mime="{{item.pumpFile.mime}}" bindtap="viewPump">查看泵单</button><view wx:if="{{user.isLeader&&item.createdBy!==user.id&&item.createdByName}}" class="small">填写人：{{item.createdByName}}</view><view class="small">理论重量 {{item.theoreticalText}}</view><view wx:if="{{item.weighedTonnes!==null}}" class="small">过磅 {{item.weighedText}} 吨 · 差额 {{item.differenceText}} 吨</view><view wx:if="{{access.shipping||user.isLeader}}" class="row"><button class="soft" data-id="{{item.id}}" bindtap="shipment">修改</button><button wx:if="{{access.shipping}}" class="danger" data-id="{{item.id}}" bindtap="void">作废</button></view></view><view wx:if="{{!shipments.length}}" class="empty">暂无发货清单</view></block>
<block wx:else><view class="tabs"><button class="{{category==='预制块'?'active':''}}" data-value="预制块" bindtap="category">预制块</button><button class="{{category==='浇注料'?'active':''}}" data-value="浇注料" bindtap="category">浇注料</button></view><button wx:if="{{access.inventory}}" class="soft" bindtap="setting">设置期初库存</button><input class="space" type="text" value="{{keyword}}" bindinput="search" placeholder="查找产品"/><view wx:for="{{rows}}" wx:key="product.id" class="stock-item"><button class="disclosure-trigger" data-id="{{item.product.id}}" bindtap="expand"><view>{{item.product.productTitle}}<view wx:if="{{item.product.productDetail}}" class="small">{{item.product.productDetail}}</view></view><text class="strong">{{item.balanceText}}</text></button><view wx:if="{{item.expanded}}" class="card"><view class="summary"><text>期初</text><text>{{item.openingText}} {{item.product.unit}}</text></view><view class="summary"><text>生产</text><text>{{item.producedText}} {{item.product.unit}}</text></view><view class="summary"><text>发货</text><text>{{item.shippedText}} {{item.product.unit}}</text></view><view class="small">实盘 {{item.physicalText}} · {{item.differenceLabel}} {{item.differenceText}}</view><view wx:if="{{item.negative}}" class="pending-note">库存为负，请核对期初、生产和发货。</view><view wx:if="{{item.issue}}" class="small">{{item.issue}}</view><button class="soft space" data-id="{{item.product.id}}" bindtap="flow">库存变化明细</button><view wx:if="{{access.inventory}}" class="row stock-edit-actions"><button class="soft" data-id="{{item.product.id}}" data-kind="opening" bindtap="setting">修改期初</button><button class="soft" data-id="{{item.product.id}}" data-kind="count" bindtap="setting">登记实盘</button></view></view></view><button wx:if="{{hasMore}}" class="soft" bindtap="more">再看30项</button></block><button wx:if="{{access.export}}" class="soft" bindtap="export">导出发货与库存</button></block>
<view wx:if="{{editing}}"><view class="card"><view class="field"><view class="field-label">发货日期</view><nice-select id="shipping-date" class="inventory-choice" options="{{editDates}}" value="{{form.date}}" font-size="{{fontSize}}" bindchange="date" bindopen="closeChoices"/></view><view class="field"><view class="field-label">客户</view><nice-select id="shipping-customer" class="inventory-choice" searchable options="{{customers}}" value="{{form.customer}}" font-size="{{fontSize}}" bindchange="customer" bindopen="closeChoices"/></view></view><view class="card"><view class="field"><view class="field-label">车号（选填）</view><input value="{{form.vehicleNumber}}" data-key="vehicleNumber" bindinput="input" maxlength="30" placeholder="请输入车号"/></view><view class="field-label">泵单（选填）</view><view class="small space">{{form.pumpFile?form.pumpFile.name:'未上传'}}</view><view class="row"><button class="soft" data-mode="camera" bindtap="uploadPump" disabled="{{busy}}">拍照上传</button><button class="soft" data-mode="file" bindtap="uploadPump" disabled="{{busy}}">选择上传</button></view><button wx:if="{{form.pumpFile}}" class="text-action" bindtap="removePump">移除泵单</button></view><view wx:for="{{entries}}" wx:key="index" class="card"><view class="record-head"><text>产品{{index+1}}</text><button wx:if="{{entries.length>1}}" class="text-action" data-index="{{index}}" bindtap="remove">移除</button></view><view class="field"><view class="field-label">产品</view><nice-select id="ship-product-{{index}}" class="inventory-choice" searchable allow-empty options="{{editProducts}}" value="{{item.productId}}" data-index="{{index}}" font-size="{{fontSize}}" bindchange="rowProduct" bindopen="closeChoices"/></view><view class="field"><view class="field-label">发货量</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="rowQuantity" placeholder="请输入"/><text class="input-unit">{{item.unit}}</text></view></view></view><button class="soft shipment-add" bindtap="add">＋ 添加产品</button><view wx:if="{{!user.isLeader||form.id}}" class="card"><view wx:if="{{!user.isLeader}}" class="field"><view class="field-label">过磅重量（吨，选填）</view><input type="digit" value="{{form.weighedTonnes}}" data-key="weighedTonnes" bindinput="input" placeholder="吨"/></view><view wx:if="{{form.id}}" class="field"><view class="field-label">修改原因</view><input value="{{form.reason}}" data-key="reason" bindinput="input" placeholder="请输入修改原因"/></view></view><button class="primary shipment-save" bindtap="save" disabled="{{busy}}">保存发货清单</button><button class="soft" bindtap="cancel">返回</button></view>
<view wx:if="{{setting}}" class="card"><view class="field"><view class="field-label">产品</view><nice-select id="setting-product" class="inventory-choice" searchable options="{{settingProducts}}" value="{{settingForm.productId}}" font-size="{{fontSize}}" bindchange="settingProduct" bindopen="closeChoices"/></view><view wx:if="{{settingKind==='opening'}}" class="field"><view class="field-label">库存起算日</view><nice-select id="setting-date" class="inventory-choice" options="{{settingDates}}" value="{{settingForm.startDate}}" font-size="{{fontSize}}" bindchange="settingDate" bindopen="closeChoices"/></view><view wx:else class="small">盘点日期：{{settingForm.date}}</view><view class="field"><view class="field-label">{{settingKind==='opening'?'起算日开始时的库存':'实盘数量'}}</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{settingForm.quantity}}" data-key="quantity" bindinput="settingInput" placeholder="请输入"/><text class="input-unit">{{settingForm.unit}}</text></view></view><view class="field"><view class="field-label">修改说明</view><input value="{{settingForm.reason}}" data-key="reason" bindinput="settingInput" placeholder="修改已有数量需说明原因"/></view><button class="primary" bindtap="saveSetting" disabled="{{busy}}">保存</button><button class="soft" bindtap="cancel">返回</button></view>
<view wx:if="{{flow}}"><button class="soft" bindtap="closeFlow">返回库存</button><view class="card"><view class="title">{{flow.product.fullName}}</view><view class="small">{{flow.from}} 至 {{flow.to}}</view><view class="summary"><text>期初</text><text>{{flow.openingText}}</text></view><view wx:for="{{flow.flows}}" wx:key="index" class="history stock-flow-row"><view class="summary"><text>{{item.date}} · {{item.kind==='production'?'生产':'销售'}}</text><text class="strong">{{item.kind==='production'?'+':'−'}}{{item.quantityText}} {{flow.product.unit}}</text></view><view class="small">{{item.kind==='shipment'?item.customer:item.workersText}}</view><view class="small">结存 {{item.balanceText}}</view></view><view wx:if="{{!flow.flows.length}}" class="empty">所选期间没有库存变化</view><view class="summary"><text>期末库存</text><text>{{flow.balanceText}}</text></view></view></view><bottom-nav user="{{user}}" current="inventory" font-size="{{fontSize}}"/></view>
