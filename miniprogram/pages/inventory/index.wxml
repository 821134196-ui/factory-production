<view class="page-shell" style="font-size:{{fontSize}}px"><block wx:if="{{!editing&&!setting&&!flow}}"><view class="tabs"><button class="{{tab==='shipments'?'active':''}}" data-value="shipments" bindtap="tab">发货清单</button><button class="{{tab==='stock'?'active':''}}" data-value="stock" bindtap="tab">库存统计</button></view><view class="inventory-date-toolbar"><view class="inventory-date-heading"><text>查询日期</text><button class="text-action" bindtap="month">本月汇总</button></view><nice-select options="{{dates}}" value="{{queryDate}}" font-size="{{fontSize}}" bindchange="queryDate"/></view>
<block wx:if="{{tab==='shipments'}}"><button wx:if="{{access.shipping||user.isLeader}}" class="primary" bindtap="shipment">填写发货清单</button><view wx:for="{{shipments}}" wx:key="id" class="card"><view class="record-head"><text>{{item.customer}}</text><text class="small">{{item.dateLabel}}</text></view><view wx:for="{{item.entries}}" wx:for-item="entry" wx:key="index" class="summary"><text>{{entry.product.fullName}}</text><text class="strong">{{entry.quantityText}} {{entry.product.unit}}</text></view><view wx:if="{{item.vehicleNumber}}" class="small">车号：{{item.vehicleNumber}}</view><button wx:if="{{item.pumpFile}}" class="text-action" data-id="{{item.pumpFile.id}}" data-mime="{{item.pumpFile.mime}}" bindtap="viewPump">查看泵单</button><view class="shipment-meta"><text>重量 {{item.theoreticalText}}</text><text wx:if="{{item.createdByName}}">填写人 {{item.createdByName}}</text></view><view wx:if="{{item.weighedTonnes!==null}}" class="small">过磅 {{item.weighedText}} 吨 · 差额 {{item.differenceText}} 吨</view><view wx:if="{{access.shipping||user.isLeader}}" class="row"><button class="soft" data-id="{{item.id}}" bindtap="shipment">修改</button><button wx:if="{{access.shipping}}" class="danger" data-id="{{item.id}}" bindtap="void">作废</button></view></view><view wx:if="{{!shipments.length}}" class="empty">暂无发货清单</view></block>
<block wx:else><view class="tabs"><button class="{{category==='预制块'?'active':''}}" data-value="预制块" bindtap="category">预制块</button><button class="{{category==='浇注料'?'active':''}}" data-value="浇注料" bindtap="category">浇注料</button></view><button wx:if="{{access.inventory}}" class="soft" bindtap="setting">设置期初库存</button><input class="space" type="text" value="{{keyword}}" bindinput="search" placeholder="查找产品"/><view wx:for="{{rows}}" wx:key="product.id" class="card inventory-product-card"><view class="inventory-product-heading"><text class="strong">{{item.product.productTitle}}</text><text wx:if="{{item.product.productDetail}}" class="small inventory-product-model"> {{item.product.productDetail}}</text></view><view class="inventory-balance"><view class="small">剩余库存</view><view class="inventory-balance-value">{{item.balanceText}}</view></view><view class="inventory-period-values"><view><view class="small">期初</view><view>{{item.openingText}} {{item.product.unit}}</view></view><view><view class="small">生产入库</view><view>{{item.producedText}} {{item.product.unit}}</view></view><view><view class="small">发货出库</view><view>{{item.shippedText}} {{item.product.unit}}</view></view></view><view wx:if="{{item.negative}}" class="pending-note">库存为负，请核对期初、生产和发货。</view><view wx:if="{{item.issue}}" class="small">{{item.issue}}</view><view class="inventory-card-actions"><button class="text-action inventory-flow-button" data-id="{{item.product.id}}" bindtap="flow">库存明细 ›</button><block wx:if="{{access.inventory}}"><button class="text-action inventory-management-toggle" data-id="{{item.product.id}}" bindtap="expand">库存管理 {{item.expanded?'⌃':'⌄'}}</button><view wx:if="{{item.expanded}}" class="inventory-management-content"><view class="small">实盘 {{item.physicalText}} · {{item.differenceLabel}} {{item.differenceText}}</view><view class="row stock-edit-actions"><button class="soft" data-id="{{item.product.id}}" data-kind="opening" bindtap="setting">修改期初</button><button class="soft" data-id="{{item.product.id}}" data-kind="count" bindtap="setting">登记实盘</button></view></view></block></view></view><button wx:if="{{hasMore}}" class="soft" bindtap="more">再看30项</button></block><button wx:if="{{access.export}}" class="soft" bindtap="export">导出发货与库存</button></block>
<view wx:if="{{editing}}" class="shipment-editor"><view class="record-detail-toolbar"><button class="detail-close" bindtap="cancel">× 关闭</button></view>
<view class="card"><view class="field"><view class="field-label">发货日期</view><nice-select id="shipping-date" class="inventory-choice" options="{{editDates}}" value="{{form.date}}" font-size="{{fontSize}}" bindchange="date" bindopen="closeChoices"/></view><view class="field"><view class="field-label">客户</view><nice-select id="shipping-customer" class="inventory-choice" searchable options="{{customers}}" value="{{form.customer}}" font-size="{{fontSize}}" bindchange="customer" bindopen="closeChoices"/></view></view>
<view wx:for="{{entries}}" wx:key="index" class="card shipment-entry"><button wx:if="{{entries.length>1}}" class="text-action remove-action shipment-remove" data-index="{{index}}" bindtap="remove">移除此项</button><view class="field"><view class="field-label">产品{{index+1}}</view><nice-select id="ship-product-{{index}}" class="inventory-choice" searchable allow-empty options="{{editProducts}}" value="{{item.productId}}" data-index="{{index}}" font-size="{{fontSize}}" bindchange="rowProduct" bindopen="closeChoices"/></view><view class="field"><view class="field-label">发货量</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="rowQuantity" placeholder="请输入"/><text class="input-unit">{{item.unit}}</text></view></view></view>
<button class="soft shipment-add" bindtap="add">＋ 添加产品</button>
<view class="card shipment-extra"><button class="text-action shipment-extra-toggle" bindtap="toggleShipmentMore"><text>选填信息</text><text class="small">车号、泵单{{user.isLeader?'':'、过磅重量'}}</text><text>{{shipmentMoreOpen?'⌃':'⌄'}}</text></button><view wx:if="{{shipmentMoreOpen}}" class="shipment-extra-body"><view class="field"><view class="field-label">车号</view><input value="{{form.vehicleNumber}}" data-key="vehicleNumber" bindinput="input" maxlength="30" placeholder="选填车号"/></view><view class="shipment-pump-label"><text>泵单</text><text class="small">{{form.pumpFile?form.pumpFile.name:'未上传'}}</text></view><view class="row"><button class="soft" data-mode="camera" bindtap="uploadPump" disabled="{{busy}}">拍照上传</button><button class="soft" data-mode="file" bindtap="uploadPump" disabled="{{busy}}">选择上传</button></view><button wx:if="{{form.pumpFile}}" class="text-action remove-action" bindtap="removePump">移除泵单</button><view wx:if="{{!user.isLeader}}" class="field"><view class="field-label">过磅重量</view><input type="digit" value="{{form.weighedTonnes}}" data-key="weighedTonnes" bindinput="input" placeholder="吨（选填）"/></view></view></view>
<view wx:if="{{form.id}}" class="card"><view class="field"><view class="field-label">修改原因</view><input value="{{form.reason}}" data-key="reason" bindinput="input" placeholder="请输入修改原因"/></view></view><button class="primary shipment-save" bindtap="save" disabled="{{busy}}">保存发货清单</button></view>
<view wx:if="{{setting}}" class="card"><view class="field"><view class="field-label">产品</view><nice-select id="setting-product" class="inventory-choice" searchable options="{{settingProducts}}" value="{{settingForm.productId}}" font-size="{{fontSize}}" bindchange="settingProduct" bindopen="closeChoices"/></view><view wx:if="{{settingKind==='opening'}}" class="field"><view class="field-label">库存起算日</view><nice-select id="setting-date" class="inventory-choice" options="{{settingDates}}" value="{{settingForm.startDate}}" font-size="{{fontSize}}" bindchange="settingDate" bindopen="closeChoices"/></view><view wx:else class="small">盘点日期：{{settingForm.date}}</view><view class="field"><view class="field-label">{{settingKind==='opening'?'起算日开始时的库存':'实盘数量'}}</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{settingForm.quantity}}" data-key="quantity" bindinput="settingInput" placeholder="请输入"/><text class="input-unit">{{settingForm.unit}}</text></view></view><view class="field"><view class="field-label">修改说明</view><input value="{{settingForm.reason}}" data-key="reason" bindinput="settingInput" placeholder="修改已有数量需说明原因"/></view><button class="primary" bindtap="saveSetting" disabled="{{busy}}">保存</button><button class="soft" bindtap="cancel">返回</button></view>
<view wx:if="{{flow}}"><button class="soft" bindtap="closeFlow">返回库存</button><view class="card stock-detail-product"><view class="strong">{{flow.product.productTitle}}</view><view wx:if="{{flow.product.productDetail}}" class="small">{{flow.product.productDetail}}</view><view class="small space">{{flow.fromLabel}}{{flow.from!==flow.to?' 至 '+flow.toLabel:''}}</view><view class="stock-detail-overview"><view><view class="small">期初库存</view><view class="strong">{{flow.openingText}}</view></view><view><view class="small">生产入库</view><view class="strong">{{flow.producedText}}</view></view><view><view class="small">发货出库</view><view class="strong">{{flow.shippedText}}</view></view><view class="stock-detail-final"><view class="small">期末库存</view><view class="strong">{{flow.balanceText}}</view></view></view></view><view class="strong space">库存变化明细</view><view wx:for="{{flow.flows}}" wx:key="index" class="card stock-ledger-entry"><view class="small">{{item.dateLabel}}</view><view class="stock-ledger-topline"><text class="stock-ledger-direction {{item.kind==='production'?'inbound':'outbound'}}">{{item.kind==='production'?'生产入库':'发货出库'}}</text><text class="stock-ledger-quantity {{item.kind==='production'?'inbound':'outbound'}}">{{item.kind==='production'?'+':'−'}}{{item.quantityText}} {{flow.product.unit}}</text></view><view wx:if="{{item.kind==='shipment'}}">{{item.customer}}</view><view class="summary"><text class="small">结存</text><text class="strong">{{item.balanceText}}</text></view><button class="text-action stock-ledger-expand" data-index="{{index}}" bindtap="flowExpand">{{item.expanded?'收起明细':item.kind==='production'?'查看生产人员':'查看发货信息'}} {{item.expanded?'⌃':'⌄'}}</button><view wx:if="{{item.expanded}}" class="stock-ledger-people"><block wx:if="{{item.kind==='production'}}"><view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="stock-production-detail"><view class="stock-participants"><text wx:for="{{record.members}}" wx:for-item="person" wx:key="id">{{person.name}}</text><text wx:if="{{!record.members.length}}">人员待设置</text></view><view class="stock-production-fields"><view class="stock-production-field"><text>{{record.members.length>1?'合计产量':'生产量'}}</text><text class="strong">{{record.quantityText}}</text></view><view wx:if="{{record.submittedName}}" class="stock-production-field"><text>填写人</text><text>{{record.submittedName}}</text></view></view></view></block><block wx:else><view>客户：{{item.customer}}</view><view wx:if="{{item.vehicleNumber}}" class="space">车号：{{item.vehicleNumber}}</view><view wx:if="{{item.submittedName}}" class="small space">填写人：{{item.submittedName}}</view></block></view></view><view wx:if="{{!flow.flows.length}}" class="empty">所选期间没有库存变化</view></view><bottom-nav user="{{user}}" current="inventory" font-size="{{fontSize}}"/></view>
