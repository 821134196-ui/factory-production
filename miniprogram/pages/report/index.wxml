<view class="page-shell" style="font-size:{{fontSize}}px"><view class="module-picker"><button wx:for="{{modules}}" wx:key="id" class="module-choice {{category===item.id?'selected':''}}" data-category="{{item.id}}" bindtap="module" disabled="{{busy}}">{{item.id==='装/卸车'?'装卸车':item.id}}</button></view>
<view wx:if="{{category==='装/卸车'}}" class="loading-switch"><button wx:for="{{loadingOperations}}" wx:key="*this" class="{{loadingOperation===item?'active':''}}" data-value="{{item}}" bindtap="operation" disabled="{{busy}}">{{item}}</button></view>

<view class="card report-card report-date-card">
<view class="field"><view class="field-label">日期</view><nice-select id="date-choice" class="report-select" options="{{dates}}" value="{{form.date}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="date" bindopen="closeChoices"/></view>
<view wx:if="{{canSelect&&!batch}}" class="field"><view class="field-label">姓名</view><nice-select id="worker-choice" class="report-select" label="姓名" searchable options="{{workers}}" value="{{form.workerId}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="worker" bindopen="closeChoices"/></view>

<block wx:if="{{!batch}}"><view wx:if="{{category!=='装/卸车'||loadingOperation!=='装车'}}" class="field"><view class="field-label">{{category==='预制块'?'产品':category==='装/卸车'?'类型':'项目'}}</view><nice-select id="product-choice" class="report-select" label="项目" searchable allow-empty options="{{products}}" value="{{form.productId}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="product" bindopen="closeChoices"/></view>
<view class="field quantity-field"><view class="field-label">{{category==='装/卸车'?loadingOperation+'量':'生产量'}}</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{form.quantity}}" data-key="quantity" bindinput="input" placeholder="请输入"/><text class="input-unit">{{product.unit}}</text></view></view><view wx:if="{{category==='预制块'}}" class="weight"><text>折合重量</text><text class="strong">{{weight}}</text></view></block></view>
<block wx:if="{{batch&&category!=='预制块'}}"><view wx:for="{{entries}}" wx:key="index" class="card bulk-entry"><view wx:if="{{entries.length>1}}" class="record-head"><text>{{item.rowLabel}}</text><button wx:if="{{entries.length>1}}" class="text-action remove-action" data-index="{{index}}" bindtap="removeRow">移除</button></view><view class="field"><view class="field-label">姓名</view><nice-select id="row-worker-{{index}}" class="report-select" label="姓名" searchable options="{{workers}}" value="{{item.workerId}}" data-index="{{index}}" font-size="{{fontSize}}" bindchange="rowWorker" bindopen="closeChoices"/></view><view wx:if="{{category!=='装/卸车'||loadingOperation!=='装车'}}" class="field"><view class="field-label">{{category==='预制块'?'产品':category==='装/卸车'?'类型':'项目'}}</view><nice-select id="row-product-{{index}}" class="report-select" label="项目" searchable allow-empty options="{{products}}" value="{{item.productId}}" data-index="{{index}}" font-size="{{fontSize}}" bindchange="rowProduct" bindopen="closeChoices"/></view><view class="field"><view class="field-label">{{category==='装/卸车'?loadingOperation+'量':'生产量'}}</view><view class="quantity-control"><input class="quantity-input" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="rowQuantity" placeholder="请输入"/><text class="input-unit">{{item.unit}}</text></view></view><view wx:if="{{category==='预制块'}}" class="weight bulk-weight"><text>折合吨数</text><text class="strong">{{item.weight}}</text></view></view><button class="soft" bindtap="addRow">＋ 添加一行</button></block>
<block wx:if="{{category==='预制块'}}"><view class="card"><view class="section-heading precast-step-heading"><view class="precast-step-title"><text class="form-step">一</text><text class="strong">选择产品</text></view></view><view wx:for="{{crewProducts}}" wx:key="index" class="precast-product-row"><view wx:if="{{crewProducts.length>1}}" class="record-head"><text>产品{{index+1}}</text><button class="text-action remove-action" data-index="{{index}}" bindtap="crewRemove">移除</button></view><view class="field"><view class="field-label">产品</view><nice-select id="crew-product-{{index}}" class="report-select" label="项目" searchable allow-empty options="{{products}}" value="{{item.productId}}" data-index="{{index}}" font-size="{{fontSize}}" bindchange="crewProduct" bindopen="closeChoices"/></view><view class="field"><view class="field-label">生产量</view><view class="quantity-control"><input class="quantity-input" type="number" value="{{item.quantity}}" data-index="{{index}}" bindinput="crewQuantity" placeholder="请输入块数"/><text class="input-unit">{{item.unit}}</text></view></view><view class="weight"><text>折合重量</text><text class="strong">{{item.weight}}</text></view></view><button class="soft" bindtap="crewAdd">＋ 添加产品</button></view><view class="card"><view class="section-heading precast-step-heading"><view class="precast-step-title"><text class="form-step">二</text><text class="strong">选择生产人员</text></view><text class="small">已选{{crewHeadcount}}人</text></view><checkbox-group bindchange="crewMembers" class="precast-person-list"><label wx:for="{{crewWorkers}}" wx:key="id" hidden="{{!item.visible}}" class="precast-person {{item.checked?'selected':''}}"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#11766d"/><view>{{item.name}}</view></label></checkbox-group><button wx:if="{{crewMore}}" class="text-action precast-people-toggle" bindtap="crewToggle">{{crewExpanded?'收起其余人员':'展开其余'+crewMore+'人'}}</button></view><view class="small form-note">以上人员共同生产，产品数量只计一次。</view></block>
<button class="primary bulk-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{category==='预制块'?'确认填报':batch?submitLabel:'提交填写'}}</button><button class="text-action form-help" bindtap="help">{{showHelp?'收起说明':'填写说明'}}</button><view wx:if="{{showHelp}}" class="small help-copy">可填写最近7天的数据。{{category==='预制块'?'先选产品及合计数量，再选共同生产人员。':canSelect?'逐行选择姓名和产品。':''}}提交后立即更新产量和工资。</view><bottom-nav user="{{user}}" current="report" font-size="{{fontSize}}"/></view>
