<view class="page-shell" style="font-size:{{fontSize}}px"><page-head title="{{user.role==='admin'?'生产详情':'记录详情'}}" subtitle="{{subtitle}}" demo="{{demoMode}}"/><view wx:if="{{record}}"><view class="card"><view class="detail-row"><text class="small">生产日期</text><text class="detail-value">{{record.date}}</text></view><view class="detail-row"><text class="small">产品</text><text class="detail-value">{{record.product.fullName}}</text></view><view wx:if="{{record.product.category==='预制块'}}" class="detail-row"><text class="small">折合重量</text><text class="detail-value">{{weight}}</text></view><view class="detail-row"><text class="small">规格 / 单位</text><text class="detail-value">{{record.product.spec}} / {{record.product.unit}}</text></view><view class="detail-row"><text class="small">填写人</text><text class="detail-value">{{record.submittedName}}</text></view><view class="detail-row"><text class="small">参与工人</text><text class="detail-value">{{record.memberNames}}</text></view><view class="detail-row"><text class="small">首次填写数量</text><text class="detail-value">{{record.originalQuantity}} {{record.originalUnit}}</text></view><view class="detail-row"><text class="small">{{record.counted?'计入汇总数量':'当前记录数量'}}</text><text class="detail-value strong">{{record.quantity}} {{record.product.unit}}</text></view><view class="detail-row"><text class="small">记录状态</text><text class="badge {{record.status}}">{{record.statusText}}</text></view><view wx:if="{{!record.batchCode&&record.product.category==='预制块'}}" class="small space">当天该产品总量：{{record.dailyQuantity}} {{record.product.unit}}（参考）</view><view wx:if="{{record.batchCode}}" class="small space">{{record.shift}} · 批次 {{record.batchCode}}；整批总量 {{record.batchQuantity}} {{record.product.unit}}（参考）</view><view wx:if="{{record.excludedReason}}" class="correction">{{record.excludedReason}}，不重复计入汇总。</view><view wx:if="{{record.remark}}" class="detail-row"><text class="small">备注</text><text class="detail-value">{{record.remark}}</text></view><view wx:if="{{record.rejectionReason}}" class="correction">{{record.rejectionReason}}</view></view><view wx:if="{{editable}}"><view class="card"><block wx:if="{{user.role==='admin'}}"><view class="field"><view class="field-label">生产日期</view><nice-select id="edit-date-choice" class="edit-select" bindopen="closeChoices" options="{{dates}}" value="{{editForm.date}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="editDate"/></view><view class="field"><view class="field-label">生产班组</view><nice-select id="edit-groups-choice" class="edit-select" bindopen="closeChoices" options="{{groups}}" value="{{editForm.groupId}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="editGroup"/></view><view class="field"><view class="field-label">产品</view><nice-select id="edit-products-choice" class="edit-select" bindopen="closeChoices" options="{{products}}" value="{{editForm.productId}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="editProduct"/></view><view class="field"><view class="field-label">实际生产工人</view><checkbox-group wx:if="{{record.mode==='shared'||record.mode==='historical-group'}}" bindchange="editMembers"><label wx:for="{{workers}}" wx:key="id" class="member"><checkbox checked="{{item.checked}}" value="{{item.id}}"/><text>{{item.name}}</text></label></checkbox-group><nice-select wx:else id="edit-workers-choice" class="edit-select" bindopen="closeChoices" options="{{workers}}" value="{{editForm.memberIds[0]}}" font-size="{{fontSize}}" disabled="{{busy}}" bindchange="editWorker"/></view><view class="field"><view class="field-label">备注</view><textarea value="{{editForm.remark}}" data-key="editForm.remark" bindinput="input" maxlength="300"/></view></block><view class="field"><view class="field-label">{{user.role==='admin'?'生产数量':'修改后的数量'}}（{{user.role==='admin'?products[productIndex].unit:record.product.unit}}）</view><input type="digit" value="{{quantity}}" data-key="quantity" bindinput="input"/></view><view class="weight"><text>修改后的重量</text><text class="strong">{{weight}}</text></view><view class="field space"><view class="field-label">修改原因</view><textarea maxlength="300" value="{{reason}}" data-key="reason" bindinput="input" placeholder="例如：现场复核，实际少4块"/></view><view class="small">工人原填数量、每次修改及原因都会保留。</view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{user.role==='admin'?'保存修改':'重新提交'}}</button></view><view wx:elif="{{record.status==='approved'&&user.role==='worker'}}" class="card"><view class="field-label">申请修改 / 提出异议</view><textarea maxlength="300" value="{{requestReason}}" data-key="requestReason" bindinput="input" placeholder="请填写希望修改的数量及原因"/><button class="soft space" bindtap="apply" disabled="{{busy}}">提交修改申请</button></view><view wx:elif="{{user.role==='worker'}}" class="small space">这条记录由{{record.submittedName}}填写，请联系填写人修改。</view><button wx:if="{{record.canDelete}}" class="secondary danger" bindtap="remove" disabled="{{busy}}">删除未确认记录</button><block wx:if="{{user.role==='worker'}}"><view class="title">修改记录</view><view class="card"><view wx:for="{{history}}" wx:key="id" class="history"><view class="strong">{{item.quantityText}} {{record.product.unit}}</view><view class="small space">{{item.actor}} · {{item.timeText}}</view><view class="small">{{item.reason}}</view></view><view wx:if="{{!history.length}}" class="empty">暂无修改记录</view></view></block></view><button class="secondary" bindtap="refresh" disabled="{{busy}}">刷新记录</button><button class="secondary" bindtap="back">返回</button></view>
