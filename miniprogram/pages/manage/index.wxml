<view class="page-shell" style="font-size:{{fontSize}}px"><view class="tabs space manage-tabs"><button wx:for="{{tabs}}" wx:key="id" class="{{tab===item.id?'active':''}}" data-tab="{{item.id}}" bindtap="tab">{{item.name}}</button></view><view wx:if="{{tab==='products'&&!editing}}" class="tabs business-tabs"><button wx:for="{{businesses}}" wx:key="value" class="{{manageCategory===item.value?'active':''}}" data-value="{{item.value}}" bindtap="business" disabled="{{busy}}">{{item.name}}</button></view><view wx:if="{{tab==='permissions'}}"><view wx:if="{{adminAdding}}" class="card"><view class="title">新增管理员</view><view class="field"><view class="field-label">姓名</view><input value="{{adminForm.name}}" data-key="name" bindinput="adminInput" maxlength="30" placeholder="请输入姓名"/></view><view class="field"><view class="field-label">手机号</view><input type="number" value="{{adminForm.phone}}" data-key="phone" bindinput="adminInput" maxlength="11" placeholder="输入11位手机号"/></view><view class="small">新增后请设置工作权限。</view><button class="primary space" bindtap="adminSave" disabled="{{busy}}">新增管理员</button><button class="soft" bindtap="adminCancel">返回列表</button></view><view wx:elif="{{permissionEditing}}" class="card"><view class="title">{{permissionUser.name}} · 设置权限</view><view class="small">审核和修改分别授权；保存后立即生效。</view><checkbox-group bindchange="permissionChange"><label wx:for="{{permissionOptions}}" wx:key="id" class="permission-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#11766d"/><view><view class="strong">{{item.name}}</view><view class="small">{{item.description}}</view></view></label></checkbox-group><button class="primary" bindtap="permissionSave" disabled="{{busy}}">保存权限</button><button class="secondary" bindtap="permissionCancel">返回列表</button></view><block wx:else><button class="primary" bindtap="adminNew">新增管理员</button><view wx:for="{{admins}}" wx:key="id" class="card"><view class="record-head"><text class="strong">{{item.name}}</text><text class="badge">{{item.isSuperAdmin?'总管理员':'管理员'}}</text></view><view class="small space">{{item.phone}}</view><view class="small space">{{item.permissionText}}</view><view wx:if="{{!item.isSuperAdmin}}" class="admin-account-actions"><button class="soft" data-id="{{item.id}}" bindtap="permissionEdit">设置权限</button><button class="danger" data-id="{{item.id}}" bindtap="adminDelete">删除</button></view></view></block></view><view wx:elif="{{editing}}"><view class="card {{tab==='products'?'product-edit-form':''}}"><view class="title">{{form.id?'编辑':'新增'}}{{tab==='users'?'员工':'产品'}}</view><view class="field"><view class="field-label">{{tab==='users'?'姓名':'名称'}}</view><input maxlength="100" value="{{form.name}}" data-key="name" bindinput="input"/></view><block wx:if="{{tab==='users'}}"><view class="field"><view class="field-label">手机号</view><input type="number" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="input"/></view><view class="field"><view class="field-label">身份</view><picker range="{{roles}}" value="{{roleIndex}}" bindchange="role"><view class="picker">{{roles[roleIndex]}} ▾</view></picker></view><view wx:if="{{roleIndex===0}}" class="field"><view class="field-label">默认预制块班组 / 组长负责班组</view><picker range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="group"><view class="picker">{{groups[groupIndex].name}} ▾</view></picker></view><view class="check-line"><switch checked="{{form.isLeader}}" color="#11766d" data-key="isLeader" bindchange="input"/><text>组长，可给组员批量填写</text></view><view class="check-line"><switch checked="{{form.expected}}" color="#11766d" data-key="expected" bindchange="input"/><text>每天需要填写</text></view></block><block wx:else><view class="field"><view class="field-label">型号</view><input value="{{form.spec}}" data-key="spec" bindinput="input"/></view><view class="field"><view class="field-label">分类</view><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex]}} ▾</view></picker></view><view class="field"><view class="field-label">单位</view><input value="{{form.unit}}" data-key="unit" bindinput="input" placeholder="块、公斤、吨、袋等"/></view><view class="field"><view class="field-label">小数位</view><picker range="{{precisions}}" value="{{precisionIndex}}" bindchange="precision"><view class="picker">{{precisionIndex}} 位小数 ▾</view></picker></view><view class="field"><view class="field-label">单重</view><view class="quantity-control"><input type="digit" value="{{form.weightKg}}" data-key="weightKg" bindinput="input" placeholder="选填"/><text class="input-unit">公斤</text></view></view><view class="field"><view class="field-label">班组</view><picker range="{{productGroups}}" range-key="name" value="{{groupIndex}}" bindchange="group"><view class="picker">{{productGroups[groupIndex].name}} ▾</view></picker></view><view class="source">{{form.source}}</view></block><view class="check-line"><switch checked="{{form.active}}" color="#11766d" data-key="active" bindchange="input"/><text>启用</text></view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存</button><button class="secondary" bindtap="cancel">返回列表</button></view><view wx:elif="{{tab==='requests'}}"><view wx:for="{{requests}}" wx:key="id" class="card"><view class="strong">{{item.name}}申请修改</view><view class="small space">{{item.reason}}</view><button class="soft space" data-id="{{item.record_id}}" bindtap="detail">查看 / 核对生产记录</button><button class="secondary" data-id="{{item.id}}" bindtap="resolve">填写处理说明</button></view><view wx:if="{{!requests.length}}" class="empty">没有待处理的申请</view></view><view wx:elif="{{tab==='users'||tab==='products'}}"><button class="primary" bindtap="edit">新增{{tab==='users'?'员工':'产品'}}</button><view class="manage-search space"><input value="{{keyword}}" bindinput="search" placeholder="{{tab==='users'?'姓名或手机号':'产品名称或型号'}}"/><button class="soft" bindtap="filter">查找</button><text class="manage-count">{{count}}条</text></view><view wx:for="{{items}}" wx:key="id" class="card space"><view class="record-head"><text class="strong">{{item.name}}</text><text class="badge {{item.active?'':'pending'}}">{{item.active?'启用':'停用 / 待配置'}}</text></view><view class="small">{{tab==='users'?(item.phone||'待绑定手机号'):item.spec}} · {{tab==='users'?item.groupName:item.unit||'单位待配置'}}</view><view wx:if="{{tab==='products'}}" class="source">{{item.source}}</view><button wx:if="{{!item.isSuperAdmin}}" class="soft space" data-id="{{item.id}}" bindtap="edit">编辑{{tab==='users'?'员工':'产品'}}</button></view></view><bottom-nav user="{{user}}" role="{{user.role}}" current="manage" font-size="{{fontSize}}"/></view>
