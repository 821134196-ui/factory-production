<view class="page-shell" style="font-size:{{fontSize}}px"><page-head title="设置" settings="{{false}}" subtitle="{{subtitle}}" demo="{{demoMode}}"/><view class="card"><view class="profile"><view class="avatar">{{initial}}</view><view><view class="strong">{{user.name}}</view><view class="small">{{roleName}}</view></view></view><view class="small space">{{user.phone}}</view></view><view wx:if="{{user.role==='admin'}}" class="card"><view class="title">我的权限</view><view class="small">{{permissionText}}</view><button class="soft space" bindtap="onShow">刷新权限</button></view><view class="card"><view class="title">字体大小</view><view class="tabs"><button wx:for="{{sizes}}" wx:key="value" class="{{fontSize===item.value?'active':''}}" data-size="{{item.value}}" bindtap="font" disabled="{{busy}}">{{item.name}}</button></view><view class="small">填写、记录、统计页一起变大。</view></view><button class="secondary" bindtap="logout" disabled="{{busy}}">退出登录</button><bottom-nav user="{{user}}" role="{{user.role}}" current="home" font-size="{{fontSize}}"/></view>
