<view class="page-shell login-page" style="font-size:{{fontSize}}px"><view class="card login-card"><view class="login-heading"><view class="login-icon"><image src="/assets/icons/phone-active.svg"/></view><view class="strong">手机号登录</view></view><view class="field"><view class="field-label">手机号</view><input type="number" maxlength="11" value="{{phone}}" data-key="phone" bindinput="input" placeholder="请输入已登记的手机号"/></view><view class="field"><view class="field-label">验证码</view><view class="login-code-row"><input type="number" maxlength="6" value="{{code}}" data-key="code" bindinput="input" placeholder="6位验证码"/><button class="soft" bindtap="send" disabled="{{busy||seconds>0}}">{{seconds>0?seconds+'秒后重发':'获取验证码'}}</button></view></view><view wx:if="{{help}}" class="small login-code-help">{{help}}</view><button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">登录</button></view></view>
