<view class="page-shell" style="font-size:{{fontSize}}px"><page-head settings="{{false}}" title="欢迎使用" subtitle="填写方便，汇总清楚" demo="{{demoMode}}"/><view class="card"><view class="avatar"><image style="width:28px;height:28px" src="/assets/icons/phone-active.svg"/></view><view class="title">手机号登录</view><view class="small">请使用管理员登记的手机号</view><view class="field space"><view class="field-label">手机号</view><input type="number" maxlength="11" value="{{phone}}" data-key="phone" bindinput="input" placeholder="输入11位手机号"/></view><button class="soft" bindtap="send" disabled="{{busy||seconds>0}}">{{seconds>0?seconds+'秒后重发':'获取验证码'}}</button><view class="small space">{{help}}</view><view class="field space"><view class="field-label">短信验证码</view><input type="number" maxlength="6" value="{{code}}" data-key="code" bindinput="input" placeholder="输入6位验证码"/></view><button class="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">登录</button></view></view>
