<view class="page-shell" style="font-size:{{fontSize}}px"><view wx:for="{{notices}}" wx:key="id" class="card"><view>{{item.message}}</view><view class="small space">{{item.timeText}}</view><button wx:if="{{item.record_id}}" class="soft space" data-id="{{item.record_id}}" bindtap="detail">查看记录</button></view><view wx:if="{{!notices.length}}" class="empty">暂时没有新消息</view><button class="secondary" bindtap="back">返回</button></view>
