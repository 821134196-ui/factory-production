<import src="../../templates/record.wxml"/>
<view class="page-shell" style="font-size:{{fontSize}}px"><page-head title="生产记录" subtitle="{{subtitle}}" demo="{{demoMode}}"/><button wx:if="{{user.role==='admin'&&(access.review||access.inventory)}}" class="primary monthly-stocktake-entry" bindtap="stocktake">月度盘点</button><range-filter today="{{today}}" admin="{{user.role==='admin'}}" month-only="{{user.role==='admin'}}" groups="{{groups}}" workers="{{workers}}" bindapply="filter"/><view class="space"><template wx:for="{{records}}" wx:key="id" is="record" data="{{r:item,access:access,batchReview:batchReview,busy:busy,user:user}}"/></view><button wx:if="{{count>records.length}}" class="soft" bindtap="more">再看30条</button><view wx:if="{{!records.length}}" class="empty">没有对应的生产记录</view><button wx:if="{{access.export}}" class="soft space" bindtap="export" disabled="{{busy}}">导出原格式月报</button><bottom-nav user="{{user}}" role="{{user.role}}" current="records" font-size="{{fontSize}}"/></view>
