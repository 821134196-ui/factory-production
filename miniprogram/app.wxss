.stocktake-actions{display:flex;gap:12px;margin-top:20px}.stocktake-actions>button{flex:1;min-width:0;min-height:54px;padding:12px 6px;margin:0;border-radius:10px;font-size:.82em;line-height:1.5}.stocktake-error{background:#fff;border:1px solid #e1b6b1;color:#aa3030}.stocktake-confirm{background:#11766d;color:#fff}
.stocktake-detail-card{margin-top:20px}.stocktake-opening{margin-top:20px}.stocktake-reopen{margin-top:24px}
.stocktake-product{display:flex;width:100%;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;background:transparent;text-align:left;padding:0;margin:0;min-height:0;border-radius:0;font-size:1em}.stocktake-product>view:first-child{min-width:0;flex:1;word-break:break-all}.stocktake-product>view:last-child{text-align:right;flex:none;font-size:.85em;margin-left:auto}.stocktake-product .small{margin-top:6px}.stocktake-timeline{border:1px solid #e1e8e5;border-radius:12px;margin:20px 0;overflow:hidden}.stocktake-flow{padding:16px;border-bottom:1px solid #e1e8e5}.stocktake-flow:last-child{border-bottom:0}.stocktake-flow-body{margin-top:16px;padding-top:12px;border-top:1px solid #e1e8e5}.stocktake-flow-body .summary{align-items:flex-start}.stocktake-flow-body .summary>.strong{flex:none}
@media(max-width:350px){.stocktake-summary{gap:7px}.stocktake-card{padding:16px}.stocktake-actions{gap:8px}.stocktake-actions>button{padding:12px 3px}}
