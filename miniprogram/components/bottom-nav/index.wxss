.nav{position:fixed;bottom:0;left:0;right:0;display:flex;gap:4px;padding:10px 10px calc(12px + env(safe-area-inset-bottom));background:white;border-top:1px solid #e1e8ef;z-index:10}.nav-item{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;padding:8px 1px;border-radius:12px;font-size:.73em;color:#5d7082}.active{background:#e7f4f0;color:#11766d;font-weight:600}.icon{font-size:19px}

.nav{padding:8px 10px calc(10px + env(safe-area-inset-bottom));border-color:#e2e7e4}.nav-item{min-height:58px;gap:3px;color:#66736e}.active{background:transparent;color:#11766d}.icon{font-size:21px;line-height:1.2}

.nav-icon{display:flex;align-items:center;justify-content:center;width:44px;height:32px;border-radius:12px}.icon-image{width:25px;height:25px}.active .nav-icon{background:#e3f2ed}
