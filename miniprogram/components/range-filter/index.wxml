<view class="tabs"><button wx:if="{{!monthOnly}}" class="{{period==='day'?'active':''}}" data-value="day" bindtap="period">今日</button><button class="{{period==='month'?'active':''}}" data-value="month" bindtap="period">本月</button><button class="{{period==='custom'?'active':''}}" data-value="custom" bindtap="period">自定义</button></view>
<button class="disclosure-trigger" bindtap="toggle">筛选{{groupIndex||workerIndex||statusIndex||(!hideCategory&&categoryIndex)?' · 已筛选':''}} <text>{{expanded?'⌃':'⌄'}}</text></button><view wx:if="{{expanded}}" class="filter-content"><view class="filter-grid"><view wx:if="{{period==='custom'}}" class="field"><view class="field-label">开始日期</view><picker mode="date" value="{{from||today}}" data-key="from" bindchange="change"><view class="picker">{{from||today}}</view></picker></view><view wx:if="{{period==='custom'}}" class="field"><view class="field-label">结束日期</view><picker mode="date" value="{{to||today}}" data-key="to" bindchange="change"><view class="picker">{{to||today}}</view></picker></view>
<picker wx:if="{{admin}}" range="{{groupOptions}}" range-key="name" value="{{groupIndex}}" data-key="groupIndex" bindchange="change"><view class="picker">{{groupOptions[groupIndex].name}} ▾</view></picker><picker wx:if="{{admin}}" range="{{workerOptions}}" range-key="name" value="{{workerIndex}}" data-key="workerIndex" bindchange="change"><view class="picker">{{workerOptions[workerIndex].name}} ▾</view></picker><picker range="{{statusOptions}}" range-key="name" value="{{statusIndex}}" data-key="statusIndex" bindchange="change"><view class="picker">{{statusOptions[statusIndex].name}} ▾</view></picker><picker wx:if="{{!hideCategory}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" data-key="categoryIndex" bindchange="change"><view class="picker">{{categories[categoryIndex].name}} ▾</view></picker></view><button wx:if="{{admin}}" class="soft space" bindtap="apply">应用筛选</button></view>
