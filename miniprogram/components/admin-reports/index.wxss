.report-view-tabs>button{display:flex;align-items:center;gap:8px}.app-icon{width:24px;height:24px;flex:none}.report-period-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.report-date-nav{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;gap:8px;align-items:center}.icon-button{width:44px;min-width:0;padding:10px;background:#fff;border:1px solid #e2e7e4}.period-caption{margin:12px 0 20px}.report-total .small{margin:8px 0}.report-number{font-size:1.65em;font-weight:650;line-height:1.3;margin:12px 0;word-break:break-all}.report-list-row{display:grid;grid-template-columns:minmax(0,1fr) auto 18px;gap:10px;background:transparent;text-align:left;justify-content:initial;border-bottom:1px solid #e2e7e4;border-radius:0;padding:16px 0;font-size:.88em;margin:0;width:100%}.report-list-row>view{min-width:0;word-break:break-all}.report-list-row>.strong{text-align:right}.row-chevron{width:18px;height:18px}.report-list-row:last-child{border:0}.report-list .strong{font-weight:600}.report-total .text-action{margin:0;min-height:32px}.report-total .record-head{align-items:center}.soft{margin-bottom:18px}
@media(max-width:380px){.report-list-row{grid-template-columns:minmax(0,1fr) 18px}.report-list-row>.strong{grid-row:2;grid-column:1;text-align:left}.row-chevron{grid-column:2;grid-row:1/3}.report-view-tabs>button{font-size:.8em;gap:6px}.report-view-tabs .app-icon{width:20px;height:20px}}
