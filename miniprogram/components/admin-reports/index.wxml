<import src="../../templates/wage-days.wxml"/><view style="font-size:{{fontSize}}px"><block wx:if="{{!detail&&report}}"><view class="home-toolbar admin-home-toolbar"><view class="tabs report-view-tabs"><button wx:if="{{canStats}}" class="{{tab==='production'?'active':''}}" data-value="production" bindtap="tab"><image class="app-icon" src="/assets/icons/stats{{tab==='production'?'-active':''}}.svg"/>生产统计</button><button wx:if="{{canWages}}" class="{{tab==='wages'?'active':''}}" data-value="wages" bindtap="tab"><image class="app-icon" src="/assets/icons/wage{{tab==='wages'?'-active':''}}.svg"/>工资统计</button></view><button class="my-settings" bindtap="openSettings"><image src="/assets/icons/settings.svg"/><text>设置</text></button></view><view class="tabs report-period-tabs"><button wx:for="{{periods}}" wx:key="id" class="{{period===item.id?'active':''}}" data-value="{{item.id}}" bindtap="period">{{item.name}}</button></view><view wx:if="{{period==='custom'}}" class="worker-range-form"><view class="range-date-fields"><view class="field"><view class="field-label">开始</view><picker mode="date" value="{{from}}" end="{{today}}" data-key="from" bindchange="range"><view class="picker date-choice">{{from}}</view></picker></view><view class="field"><view class="field-label">结束</view><picker mode="date" value="{{to}}" end="{{today}}" data-key="to" bindchange="range"><view class="picker date-choice">{{to}}</view></picker></view></view></view><view wx:else class="field summary-date-field date-only"><nice-select options="{{dates}}" value="{{report.date}}" font-size="{{fontSize}}" bindchange="date"/></view>
<block wx:if="{{tab==='production'&&report.production}}"><view class="tabs business-tabs"><button wx:for="{{businesses}}" wx:key="*this" class="{{business===item?'active':''}}" data-value="{{item}}" bindtap="business">{{item}}</button></view><view wx:if="{{business==='预制块'}}" class="field summary-date-field"><view class="field-label">班组</view><nice-select options="{{groupOptions}}" value="{{groupId}}" font-size="{{fontSize}}" bindchange="group"/></view><view class="card report-total"><view class="small">生产量</view><view class="report-number">{{report.production.quantityText}}</view><view wx:if="{{business==='预制块'}}" class="small">折合 {{report.production.weightText}}</view><view wx:if="{{report.production.recordCount===0}}" class="small">所选日期暂无{{business}}记录，请调整日期或切换品类。</view></view><button class="disclosure-trigger" data-key="showProducts" bindtap="toggle">产品明细 · {{report.production.products.length}}项</button><view wx:if="{{showProducts}}" class="card report-list"><button wx:for="{{report.production.products}}" wx:key="id" class="report-list-row" data-kind="product" data-id="{{item.id}}" bindtap="drill"><view><view class="strong">{{item.name}}</view><view class="small">{{item.groupName}} {{item.spec}}</view></view><text class="strong">{{item.quantityText}}</text><image class="row-chevron" src="/assets/icons/right.svg"/></button></view><button class="disclosure-trigger" data-key="showWorkers" bindtap="toggle">工人明细 · {{report.production.workers.length}}人</button><view wx:if="{{showWorkers}}" class="card report-list"><button wx:for="{{report.production.workers}}" wx:key="id" class="report-list-row" data-kind="worker" data-id="{{item.id}}" bindtap="drill"><view><view class="strong">{{item.name}}</view><view wx:if="{{item.sharedCount}}" class="small">另有{{item.sharedCount}}条班组合量供参考</view></view><text class="strong">{{item.quantityText}}</text><image class="row-chevron" src="/assets/icons/right.svg"/></button></view><button class="disclosure-trigger" data-key="showDaily" bindtap="toggle">每日明细 · {{report.production.daily.length}}天</button><view wx:if="{{showDaily}}" class="card report-list"><button wx:for="{{report.production.daily}}" wx:key="id" class="report-list-row" data-kind="day" data-id="{{item.id}}" bindtap="drill"><text>{{item.date}}</text><text class="strong">{{item.quantityText}}</text><image class="row-chevron" src="/assets/icons/right.svg"/></button></view></block>
<block wx:if="{{tab==='wages'&&report.wages}}"><view class="card report-total"><view class="record-head"><text class="small">工资合计</text><button wx:if="{{user.isSuperAdmin}}" class="text-action" bindtap="wageSettings">工资设置</button></view><view class="report-number">{{report.wages.totalText}}</view><view wx:if="{{report.wages.unpricedCount||report.wages.unallocatedCount}}" class="pending-note">部分单价、参与人或补助待核定</view></view><button class="disclosure-trigger" data-key="showMoney" bindtap="toggle">金额构成</button><view wx:if="{{showMoney}}" class="card"><view wx:for="{{report.wages.moneyLines}}" wx:key="name" class="summary"><text>{{item.name}}</text><text class="strong">{{item.value}}</text></view></view><view class="card report-list"><view class="strong">工人工资 · {{report.wages.people.length}}人</view><button wx:for="{{report.wages.people}}" wx:key="id" class="report-list-row" data-kind="wage-worker" data-id="{{item.id}}" bindtap="drill"><text>{{item.name}}</text><text class="strong">{{item.totalText}}</text><image class="row-chevron" src="/assets/icons/right.svg"/></button><view wx:if="{{!report.wages.people.length}}" class="empty">暂无工资</view></view></block></block>
<button wx:if="{{canExport&&!detail}}" class="soft export-report-button" bindtap="export">导出原格式月报</button><block wx:if="{{detail}}"><button class="soft" bindtap="back">返回统计</button><view class="title">{{detail.name}} · {{detail.kind==='wage-worker'?'工资明细':'生产明细'}}</view><view class="small">{{detail.from}} 至 {{detail.to}}</view><block wx:if="{{detail.kind==='wage-worker'}}"><view class="wage-total">{{detail.wages.totalText}}</view><view class="card"><view wx:for="{{detail.wages.moneyLines}}" wx:key="name" class="summary"><text>{{item.name}}</text><text>{{item.value}}</text></view><view class="small">按所选期间合计后取到分。</view></view><view class="card wage-breakdown"><template is="wage-days" data="{{days:detail.days}}"/></view></block><block wx:else><view class="wage-total">{{detail.quantityText}}</view><view wx:if="{{detail.sharedCount}}" class="small">历史班组合量仅供参考，不计个人生产量。</view><view wx:for="{{detail.records}}" wx:key="id" class="card"><view class="summary"><text class="strong">{{item.product.fullName}}</text><text>{{item.quantityText}} {{item.product.unit}}</text></view><view class="small">{{item.date}} · {{item.memberNames}}</view><button class="text-action" data-id="{{item.id}}" bindtap="record">查看记录</button></view><view wx:if="{{!detail.records.length}}" class="empty">暂无记录</view></block></block><block wx:if="{{!report&&!busy}}"><view class="home-toolbar settings-only"><button class="my-settings" bindtap="openSettings"><image src="/assets/icons/settings.svg"/><text>设置</text></button></view><view class="empty">工作权限由总管理员设置</view></block></view>
