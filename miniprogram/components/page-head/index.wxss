.head{padding:14px 3px 20px}.brand-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:23px}.brand{display:flex;align-items:center;gap:9px;font-size:.78em;font-weight:600}.mark{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#11766d;color:white;border-radius:10px;font-size:18px}.demo-tag{font-size:15px;color:#11766d;background:#e7f4f0;padding:4px 8px;border-radius:8px}.head-title{font-size:1.24em;font-weight:650;line-height:1.3}.head-sub{font-size:.78em;color:#5d7082;margin-top:7px}

.head{padding:24px 0 20px}.brand-row{margin-bottom:14px}.brand{font-weight:500;color:#66736e}.mark{width:26px;height:26px;border-radius:7px;font-size:16px}.demo-tag{background:transparent;color:#66736e;border:1px solid #e2e7e4;font-size:14px;padding:2px 6px;border-radius:6px}.head-title{font-size:1.25em}.head-sub{color:#66736e;margin-top:6px}.settings-entry{background:transparent;border:0;color:#66736e;padding:8px 0 8px 12px;min-height:44px;font-size:.78em}

.brand-icon{width:20px;height:20px}.mark{width:34px;height:34px;border-radius:11px;background:linear-gradient(140deg,#13867a,#0b615b);box-shadow:0 3px 10px #11766d20}.settings-icon{width:21px;height:21px;margin-right:7px}
