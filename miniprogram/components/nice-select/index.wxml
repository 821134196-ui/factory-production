<view class="select-menu" style="font-size:{{fontSize}}px"><button class="select-trigger {{open?'expanded':''}}" bindtap="toggle" disabled="{{disabled}}" aria-label="{{selected.name}}"><view class="select-copy"><text class="select-title">{{selected?selected.name:'请选择'}}</text><text wx:if="{{selected.detail}}" class="select-meta">{{selected.detail}}</text></view><view class="chevron {{open?'up':''}}"></view></button><view wx:if="{{open&&searchable}}" class="select-search"><input type="text" value="{{keyword}}" bindinput="search" placeholder="输入名称或规格查找"/></view><scroll-view wx:if="{{open}}" scroll-y class="select-options" style="height:{{filtered.length<4?filtered.length*76+12:290}}px" scroll-top="{{scrollTop}}"><view class="option-padding"><view wx:if="{{!filtered.length}}" class="select-empty">没有找到匹配内容</view><button wx:for="{{filtered}}" wx:key="id" class="select-option {{item.id===value?'selected':''}}" data-value="{{item.id}}" bindtap="choose" disabled="{{disabled}}"><view class="select-copy"><text class="select-title">{{item.name}}</text><text wx:if="{{item.detail}}" class="select-meta">{{item.detail}}</text></view><view class="select-check {{item.id===value?'visible':''}}">✓</view></button></view></scroll-view></view>
