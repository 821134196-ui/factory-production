<view class="select-menu" style="font-size:{{fontSize}}px">
  <button class="select-trigger {{open?'expanded':''}}" bindtap="toggle" disabled="{{disabled}}" aria-label="{{selected.name}}">
    <view class="select-copy"><text class="select-title">{{selected?selected.name:'请选择'}}</text><text wx:if="{{selected.detail}}" class="select-meta">{{selected.detail}}</text></view><view class="chevron {{open?'up':''}}"></view>
  </button>
  <scroll-view wx:if="{{open&&!searchable}}" scroll-y class="select-options" style="height:{{filtered.length<4?filtered.length*76+12:290}}px" scroll-top="{{scrollTop}}">
    <view class="option-padding">
      <view wx:if="{{!filtered.length}}" class="select-empty">没有找到匹配内容</view>
      <button wx:for="{{filtered}}" wx:key="id" class="select-option {{item.id===value?'selected':''}}" data-value="{{item.id}}" bindtap="choose" disabled="{{disabled}}">
        <view class="select-copy"><text class="select-title">{{item.name}}</text><text wx:if="{{item.detail}}" class="select-meta">{{item.detail}}</text></view><view class="select-check {{item.id===value?'visible':''}}">✓</view>
      </button>
    </view>
  </scroll-view>
  <view wx:if="{{open&&searchable}}" class="select-overlay">
    <view class="select-backdrop" bindtap="close" catchtouchmove="stopScroll"></view>
    <view class="select-sheet" style="bottom:{{keyboardHeight}}px;height:{{keyboardHeight>0?'calc(100vh - '+keyboardHeight+'px - 12px)':'88vh'}}">
      <view class="select-sheet-header" catchtouchmove="stopScroll">
        <view class="select-sheet-heading"><text class="strong">{{label==='选择内容'?label:'选择'+label}}</text><button class="select-sheet-close" bindtap="close">关闭</button></view>
        <view class="select-search"><input type="text" value="{{keyword}}" bindinput="search" adjust-position="{{false}}" bindkeyboardheightchange="keyboard" placeholder="输入名称或规格查找"/></view>
      </view>
      <scroll-view scroll-y class="select-sheet-options" scroll-top="{{scrollTop}}">
        <view class="option-padding">
          <view wx:if="{{!filtered.length}}" class="select-empty">没有找到匹配内容</view>
          <button wx:for="{{filtered}}" wx:key="id" class="select-option {{item.id===value?'selected':''}}" data-value="{{item.id}}" bindtap="choose" disabled="{{disabled}}">
            <view class="select-copy"><text class="select-title">{{item.name}}</text><text wx:if="{{item.detail}}" class="select-meta">{{item.detail}}</text></view><view class="select-check {{item.id===value?'visible':''}}">✓</view>
          </button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
