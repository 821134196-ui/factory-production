.select-menu{width:100%;min-width:0}.select-trigger,.select-option{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:60px;width:100%;margin:0;white-space:normal;border-radius:14px;padding:13px 15px;font-size:.94em;line-height:1.5;text-align:left;color:#1c2e40}.select-trigger{background:linear-gradient(120deg,#f6faf9,#f1f6f7);border:1px solid #dce7e7}.select-trigger.expanded{border-color:#11766d;box-shadow:0 0 0 3px #11766d12}.select-trigger::after,.select-option::after{border:0}.select-copy{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;word-break:break-all}.select-title{font-weight:550}.select-meta{font-size:.78em;color:#5d7082;font-weight:400}.chevron{width:9px;height:9px;border-right:2px solid #11766d;border-bottom:2px solid #11766d;transform:rotate(45deg);flex-shrink:0;margin:0 5px 5px}.chevron.up{transform:rotate(225deg);margin-top:8px}.select-options{height:290px;max-width:100%;margin-top:8px;box-sizing:border-box;background:#fff;border:1px solid #dce7e7;border-radius:16px;box-shadow:0 8px 22px #203c5512}.option-padding{padding:6px}.select-option{background:#fff;min-height:56px;padding:13px 12px;margin:2px 0;border-radius:11px}.select-option.selected{background:#e7f4f0;color:#11766d}.select-check{visibility:hidden;display:flex;align-items:center;justify-content:center;width:25px;height:25px;flex-shrink:0;border-radius:50%;background:#11766d;color:#fff;font-size:16px}.select-check.visible{visibility:visible}

.select-search{padding:8px 0}.select-search input{box-sizing:border-box;padding:12px 14px;border:1px solid #dce7e7;border-radius:12px;min-height:52px}.select-empty{padding:18px;font-size:.8em;color:#788b84}

.select-trigger{background:#fff;border-color:#d5dfd9;border-radius:10px;padding:12px 14px;box-shadow:none}.select-title{font-weight:500}.select-copy{gap:2px}.select-meta{color:#66736e}.select-options{border-color:#e2e7e4;border-radius:12px;box-shadow:0 8px 24px #203c5517}.select-check{background:transparent;color:#11766d;width:22px;height:22px;font-size:14px}.chevron{border-color:#66736e}.select-option.selected{background:#edf5f2}
