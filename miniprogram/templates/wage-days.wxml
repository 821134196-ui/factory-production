<template name="wage-days"><view wx:for="{{days}}" wx:key="date" class="wage-day"><view class="wage-day-heading"><text class="strong">{{item.date}}</text><text wx:if="{{!supplementsOnly}}" class="strong">{{item.totalText}}</text></view><view class="wage-day-lines"><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="index" class="wage-item"><view class="wage-item-title">{{line.name}}</view><view class="wage-item-values"><block wx:if="{{line.kind!=='adjustment'}}"><view><text>{{line.quantityLabel}}</text><text>{{line.quantityText}}</text></view><view><text>单价</text><text>{{line.rateText}}</text></view></block><view class="wage-item-amount"><text>金额</text><text>{{line.amountText}}</text></view></view><view wx:if="{{line.reason}}" class="small">{{line.reason}}</view></view></view></view><view wx:if="{{!days.length}}" class="empty">暂无明细</view></template>
