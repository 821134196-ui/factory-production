<template name="record"><view class="card record"><view class="record-head"><text class="record-name">{{r.product.fullName}}</text><text class="badge {{r.status}}">{{r.excludedReason?'已替换':r.statusText}}</text></view><view class="record-amount"><view><text class="strong">{{r.quantityText}} {{r.product.unit}}</text><view wx:if="{{r.product.category==='预制块'}}" class="small">折合重量 {{r.weightText}}</view></view><text class="small">{{r.date}}</text></view><view class="small">{{r.memberNames}} · {{r.groupName}}</view><view wx:if="{{r.rejectionReason}}" class="correction">{{r.rejectionReason}}</view><view wx:if="{{user.role==='admin'||user.isLeader}}" class="record-actions"><button class="soft" data-id="{{r.id}}" bindtap="detail">详情</button></view></view></template>
